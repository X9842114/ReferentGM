{
  "name": "refgm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:setup": "node scripts/setup-db.mjs",
    "db:reset": "node -e \"const {Client}=require('pg');(async()=>{const c=new Client({connectionString:process.env.DATABASE_URL||'postgresql://postgres:postgres@127.0.0.1:5432/refgm'});await c.connect();await c.query('truncate refgm_accounts, refgm_profiles, refgm_kv');await c.end();})()\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
