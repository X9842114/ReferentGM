# Copier ce fichier vers .env.local (dev) ou .env (serveur).
# Ne jamais committer .env / .env.local.

# ID Discord Développeur. NEXT_PUBLIC_ pour que le navigateur voie la même liste.
NEXT_PUBLIC_DEVELOPER_DISCORD_IDS=694836118520070145,211579197242605568

# Port du site. Next lit PORT tout seul (défaut Next : 3000).
PORT=3010

# URL publique exacte, sans slash final.
AUTH_URL=https://gamemaster.fbfa.fr
AUTH_TRUST_HOST=true

# openssl rand -base64 32
AUTH_SECRET=

# Discord OAuth — https://discord.com/developers/applications
# Redirect EXACT :
#   https://gamemaster.fbfa.fr/api/auth/callback/discord
# En local, ajouter aussi :
#   http://localhost:3010/api/auth/callback/discord
# Scopes : identify, guilds, guilds.members.read
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# PostgreSQL sur le VPS. Pas de Supabase.
REFGM_USE_LOCAL_PG=true
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@127.0.0.1:5432/refgm

# Carte de l'atelier (optionnel)
# NEXT_PUBLIC_WEBMAP_URL=https://webmap.dynasty8.fbfa.fr/map.svg

# Idées de mission par IA (optionnel)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
